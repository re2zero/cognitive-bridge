{
  "name": "@re2zero/cog",
  "version": "0.2.11",
  "description": "轻量级认知增强插件：为 pi 注入身份认知 + 动态 NAP 叙事锚点",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cog": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build",
    "postinstall": "node -e \"try{require('better-sqlite3')}catch(e){if(e.code==='ERR_DLOPEN_FAILED')require('child_process').execSync('npm rebuild better-sqlite3',{stdio:'inherit'})}\""
  },
  "keywords": [
    "pi",
    "cognitive",
    "narrative",
    "anchor",
    "identity",
    "emotion"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "opencode": {
    "plugin": "./dist/opencode-entry.js"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.6.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=0.0.1"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.14",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/",
    "config/"
  ],
  "allowScripts": {
    "better-sqlite3": true
  }
}
